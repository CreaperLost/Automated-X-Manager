# X-Automation secrets template.
# Copy this file to .env and fill in real values.
# .env is gitignored; never commit secrets.

# ---- X API (developer.x.com) ----
# App-level Bearer Token. Used for read-only requests (cheaper, no user context).
# Get from: https://console.x.com  ->  your app  ->  Keys and Access Tokens
X_BEARER_TOKEN=

# OAuth 2.0 Client ID. Used for user-context requests (writes, media uploads).
# Get from the same page; under "OAuth 2.0 Client ID and Client Secret".
X_CLIENT_ID=

# OAuth 2.0 Client Secret. Same page.
X_CLIENT_SECRET=

# Override the local callback port (default 8765). If changed, register the
# matching URL in the X developer portal:
#   http://127.0.0.1:<port>/callback
X_AUTH_CALLBACK_PORT=8765

# ---- MiniMax API ----
MINIMAX_API_KEY=

# Override the MiniMax base URL only if you proxy through a different host.
MINIMAX_BASE_URL=https://api.minimax.io/v1
